{
  "manifest_version": 2,
  "name": "Error Nexus Tools",
  "version": "1.8",
  "description": "Scan images, check URLs, extract EXIF and EOF metadata directly on webpages.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "optional_permissions": ["<all_urls>"],
  "background": {
  "scripts": [
      "shared/browser.js",
      "background/log.js",
      "background/metadata.js",
      "background/extensions.js",
      "background/queue.js",
      "background/scan.js",
      "background/register.js",
      "background/main.js"
    ]
  },

    "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "error-nexus-tools-1@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}

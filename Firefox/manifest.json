{
  "manifest_version": 2,
  "name": "Error Nexus Tools",
  "version": "1.4",
  "description": "Scan images, check URLs, extract EXIF and EOF metadata directly on webpages.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],

  "background": {
    "scripts": ["background.js"]
  },

    "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],

  "browser_specific_settings": {
    "gecko": {
      "id": "error-nexus-tools-1@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
